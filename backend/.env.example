# Copy to backend/.env — every value is optional and has a sane default.

# --- Django core ---
DJANGO_SECRET_KEY=dev-birge-secret-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true

# --- AI buyer: Google Gemini (get a free key at aistudio.google.com/apikey) ---
# Without it, the AI buyer falls back to the deterministic rule-based matcher.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Real web product search (SerpApi Google Shopping) ------------------------
# When the local catalog has no match, the AI buyer pulls a real product from
# the web. Get a key at serpapi.com (free tier). Leave SERPAPI_KEY empty to
# disable (the AI buyer will just say "not found").
EXTERNAL_SEARCH_ENABLED=true
SERPAPI_KEY=
SERPAPI_GL=kz
SERPAPI_HL=ru

# --- Pricing / SIM ------------------------------------------------------------
KZT_PER_USD=450
SIM_CODE_TTL_MINUTES=10
SIM_RESEND_COOLDOWN_SECONDS=30
# Show the OTP code in API responses (dev only; defaults to DJANGO_DEBUG)
# SIM_RETURN_CODE_IN_RESPONSE=true

# --- SMS gateway (real SIM OTP delivery) --------------------------------------
# console = dev (prints code, no real SMS). Switch to a provider for real SIM:
SMS_PROVIDER=console
# Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Mobizon (Kazakhstan):
MOBIZON_API_KEY=
MOBIZON_API_URL=https://api.mobizon.kz
# SMSC.kz:
SMSC_LOGIN=
SMSC_PASSWORD=

# --- Seed accounts (python manage.py seed_demo) -------------------------------
SEED_DEMO_PASSWORD=birge123
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
