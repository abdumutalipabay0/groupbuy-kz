# Point this at the Django backend. For a two-phone LAN demo use the laptop's
# LAN IP (e.g. http://192.168.0.10:8000) so the second phone can reach the API.
VITE_API_URL=http://127.0.0.1:8000

# Currency conversion for display (USD stored internally). Keep in sync with the
# backend KZT_PER_USD.
VITE_KZT_PER_USD=450
VITE_RUB_PER_USD=90

# Polling cadences (ms): live group price/members, and the real-notifications poll.
VITE_GROUP_POLL_MS=3000
VITE_NOTIFY_POLL_MS=8000
